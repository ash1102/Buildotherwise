{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "confusing_step",
        "usability",
        "shared_entry"
      ],
      "default": "usability"
    },
    "module_order": {
      "type": "number"
    },
    "lesson_code": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "description": "What the person chose to send. Only ever what they explicitly submitted."
    },
    "email": {
      "type": "string",
      "description": "Reply address, only when the person typed one on the contact form."
    },
    "description": {
      "type": "string",
      "description": "Optional short text about this record (up to 1000 characters), used for search and previews."
    },
    "entry_label": {
      "type": "string",
      "description": "Set only when a journal entry is deliberately shared, so the scope is stated."
    }
  },
  "required": [
    "kind",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}