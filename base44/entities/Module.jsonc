{
  "name": "Module",
  "properties": {
    "description": {
      "description": "Optional short text about this module (up to 1000 characters), used for search and previews.",
      "type": "string"
    },
    "kind": {
      "default": "module",
      "enum": [
        "orientation",
        "module"
      ],
      "type": "string"
    },
    "order": {
      "description": "Position in the ratified ten-module program. 0 is Getting Started.",
      "type": "number"
    },
    "purpose": {
      "description": "One honest sentence on what the module does.",
      "type": "string"
    },
    "slug": {
      "description": "URL slug used for the module page.",
      "type": "string"
    },
    "status": {
      "default": "live",
      "description": "Only live modules can be entered or marked complete.",
      "enum": [
        "live",
        "coming_later",
        "in_development"
      ],
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "title": {
      "description": "Participant-facing module name.",
      "type": "string"
    }
  },
  "required": [
    "order",
    "slug",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}